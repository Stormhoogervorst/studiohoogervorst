---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FaqList from "../../components/FaqList.astro";
import TrustRating from "../../components/TrustRating.astro";
import CalBooking from "../../components/CalBooking.astro";

const title = "Contact: plan een gesprek over jouw website | Neqst";
const description =
  "Twintig minuten bellen over je huidige website en wat er te winnen valt. Geen verkooppraatje: als het niet past, zeggen we dat. Reactie binnen één werkdag.";

const site = Astro.site ?? new URL("https://neqst.nl");
const pageUrl = new URL(Astro.url.pathname, site).href;

const telefoon = "+31 6 85 68 09 98";
const email = "storm@neqst.nl";
const linkedinUrl = "https://www.linkedin.com/company/stormsites";

const faqs = [
  {
    vraag: "Wat kost een gesprek?",
    antwoord:
      "Niets. Dertig minuten, en je zit nergens aan vast. Als het niet past zeggen we dat, dan heb je in ieder geval een eerlijk antwoord.",
  },
  {
    vraag: "Waar moet ik op voorbereid zijn?",
    antwoord:
      "Nergens op. Handig is als je weet hoeveel aanvragen je nu via je site krijgt, maar als je dat niet bijhoudt is dat ook een antwoord.",
  },
  {
    vraag: "Hoe snel kunnen we beginnen?",
    antwoord:
      "Meestal binnen een week na het gesprek. De site staat twee tot drie weken later online, mits je teksten en beeld op tijd aanlevert.",
  },
  {
    vraag: "Werken jullie alleen in Gelderland?",
    antwoord:
      "Nee. We zitten in Nijmegen en hebben klanten in Arnhem en Utrecht, maar het werk gebeurt grotendeels op afstand. Locatie maakt niet uit.",
  },
  {
    vraag: "Ik heb al een website. Is dit dan zinvol?",
    antwoord:
      "Vaak wel. We kijken gratis naar je huidige site en zeggen eerlijk of aanpassen genoeg is of dat opnieuw bouwen verstandiger is.",
  },
  {
    vraag: "Wat als ik nog niet weet wat ik wil?",
    antwoord:
      "Dan is dit precies het juiste moment om te bellen. Het gesprek is er om uit te zoeken wat je nodig hebt, niet om iets te verkopen.",
  },
];

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: title,
  description,
  url: pageUrl,
  inLanguage: "nl-NL",
  isPartOf: {
    "@type": "WebSite",
    name: "Neqst",
    url: site.href,
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: new URL("/", site).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Contact",
      item: pageUrl,
    },
  ],
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Neqst",
  url: site.href,
  email,
  telephone: telefoon.replace(/\s+/g, ""),
  description:
    "Websites op abonnementsbasis, gebouwd om gevonden te worden door Google én AI-modellen.",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Nijmegen",
    addressRegion: "Gelderland",
    addressCountry: "NL",
  },
  areaServed: "NL",
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <SiteHeader />

  <main id="inhoud">
    <section class="hero" id="contact">
      <div class="hero-inner">
        <div class="intro">
          <p class="pill">
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
              <circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.3"></circle>
              <path d="M8 5v3.2L10.2 10" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path>
            </svg>
            Reactie binnen 1 werkdag
          </p>
          <h1>Plan direct een kennismaking</h1>
          <p class="lede">
            Kies een moment dat jou uitkomt. Het gesprek duurt 30 minuten en is
            vrijblijvend.
          </p>
          <div class="hero-rating">
            <TrustRating align="start" />
          </div>
        </div>

        <div class="card">
          <CalBooking />
        </div>
      </div>
    </section>

    <section class="other">
      <div class="wrap">
        <h2>Liever op een andere manier?</h2>
        <div class="ways">
          <article class="way">
            <h3>Direct mailen</h3>
            <p>Voor vragen, samenwerkingen of iets anders</p>
            <a href={`mailto:${email}`}>{email}</a>
          </article>
          <article class="way">
            <h3>Even bellen</h3>
            <p>Bereikbaar op werkdagen tussen 9 en 18 uur</p>
            {
              telefoon ? (
                <a href={`tel:${telefoon.replace(/\s+/g, "")}`}>{telefoon}</a>
              ) : (
                <span class="todo">Nummer volgt</span>
              )
            }
          </article>
          <article class="way">
            <h3>Volgen</h3>
            <p>Wat we bouwen en wat we leren onderweg</p>
            {
              linkedinUrl ? (
                <a href={linkedinUrl} rel="noopener noreferrer">LinkedIn</a>
              ) : (
                <span class="todo">LinkedIn volgt</span>
              )
            }
          </article>
        </div>
      </div>
    </section>

    <section class="faq" id="faq">
      <div class="wrap">
        <div class="split">
          <div>
            <p class="badge badge-dark">FAQ</p>
            <h2>Voordat je belt.</h2>
          </div>
          <p class="faq-lede">
            De vragen die het vaakst langskomen. Staat die van jou er niet bij,
            stel hem gewoon.
          </p>
        </div>
        <FaqList faqs={faqs} tint="navy" />
      </div>
    </section>

    <section class="close">
      <div class="wrap close-inner">
        <h2>Nog steeds aan het twijfelen?</h2>
        <p>
          Stuur gewoon een mail met je website erin. Je krijgt binnen een
          werkdag een eerlijke inschatting terug, gratis.
        </p>
        <a class="btn" href={`mailto:${email}`}>Mail ons direct</a>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .hero {
    padding: 90px 24px;
    background: var(--navy);
    color: #fff;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 64px;
    align-items: start;
    max-width: var(--max);
    margin-inline: auto;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 22px;
    padding: 6px 12px 6px 10px;
    border: 1px solid var(--navy-line);
    border-radius: 999px;
    background: var(--navy-card);
    color: #cddbe3;
    font-size: 0.82rem;
    font-weight: 500;
  }

  .pill svg {
    flex-shrink: 0;
  }

  .lede {
    max-width: 460px;
    margin-top: 18px;
    color: #b6c8d2;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .hero-rating {
    margin-top: 48px;
  }

  .card {
    min-width: 0;
    padding: 34px;
    border: 1px solid var(--navy-line);
    border-radius: 20px;
    background: var(--navy-card);
  }

  .other {
    padding: var(--section) 0;
    background: var(--navy);
    color: #fff;
    text-align: center;
  }

  .ways {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 40px;
    text-align: left;
  }

  .way {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 28px;
    border: 1px solid var(--navy-line);
    border-radius: 16px;
    background: var(--navy-card);
  }

  .way h3 {
    font-size: 1.15rem;
  }

  .way p {
    margin-top: 10px;
    color: #b6c8d2;
    line-height: 1.55;
  }

  .way a,
  .way .todo {
    margin-top: auto;
    padding-top: 20px;
    color: var(--lime);
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .way a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .way .todo {
    color: var(--dim);
    font-weight: 500;
  }

  .faq {
    padding: var(--section) 0;
    background: var(--navy);
    color: #fff;
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px 48px;
    align-items: end;
    margin-bottom: 48px;
  }

  .badge {
    display: inline-flex;
    margin-bottom: 16px;
    padding: 5px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .badge-dark {
    border-color: var(--navy-line);
    color: rgba(255, 255, 255, 0.8);
  }

  .faq-lede {
    color: #b6c8d2;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .close {
    padding: var(--section) 0;
    background: var(--navy);
    color: #fff;
    text-align: center;
  }

  .close-inner {
    max-width: 640px;
  }

  .close p {
    margin: 18px auto 28px;
    color: var(--dim);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  @media (max-width: 939px) {
    .hero {
      padding: 64px 20px;
    }

    .hero-inner,
    .ways,
    .split {
      grid-template-columns: 1fr;
    }

    .card {
      padding: 24px 20px;
    }
  }
</style>
