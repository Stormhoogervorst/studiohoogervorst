---
const destination = "/contact/";
---

<html lang="nl-NL">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <link rel="canonical" href="https://neqst.nl/contact/" />
    <title>Doorverwijzen naar contact</title>
    <script is:inline define:vars={{ destination }}>
      location.replace(destination);
    </script>
  </head>
  <body>
    <p>Je wordt doorgestuurd naar <a href={destination}>contact</a>.</p>
  </body>
</html>
