---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import FaqList from "../components/FaqList.astro";
import PrijzenSectie from "../components/PrijzenSectie.astro";
import UitgelichteProjecten from "../components/UitgelichteProjecten.astro";
import KernwaardenSectie from "../components/KernwaardenSectie.astro";
import BewijsSectie from "../components/BewijsSectie.astro";
import TrustRating from "../components/TrustRating.astro";
import VergelijkingSectie from "../components/VergelijkingSectie.astro";

interface Props {
  entry: CollectionEntry<"landing">;
  gerelateerd: CollectionEntry<"landing">[];
}

export async function getStaticPaths() {
  const landings = await getCollection("landing", ({ data }) => data.gepubliceerd);
  const landingById = new Map(landings.map((item) => [item.id, item]));

  return landings.map((entry) => {
    const gerelateerd = entry.data.gerelateerd
      .map((slug) => landingById.get(slug))
      .filter((item): item is CollectionEntry<"landing"> => Boolean(item));

    return {
      params: { slug: entry.id },
      props: {
        entry,
        gerelateerd,
      } satisfies Props,
    };
  });
}

const { entry, gerelateerd } = Astro.props;
const {
  h1,
  titel,
  beschrijving,
  intro,
  zoekterm,
  stad,
  vindbaarheid_keyword,
  probleem,
  vergelijking,
  vergelijking_kop,
  wanneer_niet_kop,
  wanneer_niet,
  proces,
  case_intro,
  case_slugs,
  extra_kop,
  extra_tekst,
  overnemen,
  faqs,
} = entry.data;

const isWaas = entry.id === "website-as-a-service";
const primaireCta = isWaas
  ? { href: "/abonnement/", label: "Bekijk de prijzen" }
  : { href: "/contact/", label: "Stuur je site, krijg een eerlijke inschatting" };
const secundaireCta = isWaas
  ? { href: "/contact/", label: "Plan een gesprek" }
  : { href: "/abonnement/", label: "Bekijk de prijzen" };

const site = Astro.site ?? new URL("https://neqst.nl");
const pageUrl = new URL(Astro.url.pathname, site).href;

const address = {
  "@type": "PostalAddress",
  streetAddress: "Hugo de Grootstraat 30",
  postalCode: "6522 DE",
  addressLocality: "Nijmegen",
  addressRegion: "Gelderland",
  addressCountry: "NL",
};

const areaServed = stad
  ? { "@type": "City", name: stad }
  : "NL";

const professionalServiceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Neqst",
  url: site.origin,
  description: beschrijving,
  email: "hoogervorstworks@gmail.com",
  telephone: "+31685680998",
  address,
  areaServed,
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: titel,
  serviceType: zoekterm,
  description: beschrijving,
  url: pageUrl,
  provider: {
    "@type": "ProfessionalService",
    name: "Neqst",
    url: site.origin,
    address,
  },
  areaServed,
  offers: {
    "@type": "Offer",
    price: 129,
    priceCurrency: "EUR",
    description: "€129 per maand + €395 setup, 12 maanden minimum",
    url: new URL("/abonnement/", site).href,
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: new URL("/", site).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: h1,
      item: pageUrl,
    },
  ],
};
---

<BaseLayout title={titel} description={beschrijving}>
  <script type="application/ld+json" set:html={JSON.stringify(professionalServiceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <SiteHeader />

  <main id="inhoud">
    <section class="hero">
      <div class="wrap hero-inner">
        <h1>{h1}</h1>
        <p class="sub">{intro}</p>
        <div class="actions">
          <a class="btn" href={primaireCta.href}>{primaireCta.label}</a>
          <a class="btn btn-outline" href={secundaireCta.href}>{secundaireCta.label}</a>
        </div>
        <div class="hero-rating">
          <TrustRating />
        </div>
      </div>
    </section>

    <section class="probleem">
      <div class="wrap">
        <h2>Herken je dit?</h2>
        <p class="probleem-lede">
          {
            probleem.length === 4
              ? "Vier dingen die we bijna elke week horen van bedrijven die contact opnemen."
              : "Drie dingen die we bijna elke week horen van bedrijven die contact opnemen."
          }
        </p>
        <ol class:list={["probleem-grid", probleem.length === 4 && "probleem-grid--4"]}>
          {
            probleem.map((item, i) => (
              <li>
                <span class="nr" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h3>{item.kop}</h3>
                <p>{item.tekst}</p>
              </li>
            ))
          }
        </ol>
        <a class="btn probleem-cta" href="/contact/">Plan kennismaking</a>
      </div>
    </section>

    <BewijsSectie />

    <KernwaardenSectie vindbaarheidPunt={vindbaarheid_keyword} />

    <section class="aanpak">
      <div class="wrap">
        <h2>Zo pakken we het aan.</h2>
        <ol class="proces-grid">
          {
            proces.map((item, i) => (
              <li>
                <span class="nr" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h3>{item.kop}</h3>
                <p>{item.tekst}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {
      overnemen && !isWaas && (
        <section class="overnemen">
          <div class="overnemen-inner">
            <h2>Wat wij van je overnemen.</h2>
            <p class="overnemen-lede">
              Je levert je teksten, je beeld en je logo aan. De rest is niet meer jouw
              probleem.
            </p>
            <ul class="overnemen-lijst">
              {overnemen.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <UitgelichteProjecten
      limiet={2}
      ids={case_slugs}
      kop="En zo pakt het uit."
      lede={case_intro}
      compactTop
    />

    {
      overnemen && isWaas && (
        <section class="overnemen">
          <div class="overnemen-inner">
            <h2>Wat wij van je overnemen.</h2>
            <p class="overnemen-lede">
              Je levert je teksten, je beeld en je logo aan. De rest is niet meer jouw
              probleem.
            </p>
            <ul class="overnemen-lijst">
              {overnemen.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {
      extra_kop && extra_tekst && isWaas ? (
        <section class="waas-uitleg">
          <div class="waas-uitleg-inner">
            <p class="waas-uitleg-label">Het eerlijke verhaal</p>
            <div class="waas-uitleg-grid">
              <h2>{extra_kop}</h2>
              <div class="waas-uitleg-copy">
                <p>{extra_tekst}</p>
                <p class="waas-uitleg-kern">
                  <span>De kern</span>
                  Wij verdienen pas als jij blijft, en dat doe je alleen als de site
                  iets oplevert.
                </p>
              </div>
            </div>
          </div>
        </section>
      ) : extra_kop && extra_tekst ? (
        <section class="extra">
          <div class="extra-inner">
            <h2>{extra_kop}</h2>
            <p>{extra_tekst}</p>
          </div>
        </section>
      ) : null
    }

    <VergelijkingSectie kop={vergelijking_kop} rijen={vergelijking} />

    {
      wanneer_niet_kop && wanneer_niet && (
        <section class="wanneer">
          <div class="wrap wanneer-inner">
            <h2>{wanneer_niet_kop}</h2>
            <p>{wanneer_niet}</p>
          </div>
        </section>
      )
    }

    {isWaas ? null : <PrijzenSectie flushTop />}

    <section class="faq" id="faq">
      <div class="wrap">
        <div class="split">
          <div>
            <p class="badge">FAQ</p>
            <h2>Veelgestelde vragen,<br />eerlijke antwoorden.</h2>
          </div>
          <div class="faq-aside">
            <p class="faq-lede">
              Staat je vraag er niet bij? Neem contact met ons op!
            </p>
            <a class="btn" href="/contact/">Neem contact op</a>
          </div>
        </div>
        <FaqList faqs={faqs} tint="navy" />
      </div>
    </section>

    <section class="close">
      <div class="wrap close-inner">
        <h2>Twintig minuten. Daarna weet je het.</h2>
        <a class="btn" href="/contact/">Plan een gesprek</a>
        {
          !isWaas && gerelateerd.length > 0 && (
            <nav class="related" aria-label="Gerelateerd">
              {gerelateerd.map((pagina) => (
                <a href={`/${pagina.id}/`}>{pagina.data.h1}</a>
              ))}
            </nav>
          )
        }
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .hero {
    padding: 88px 0 64px;
    background: var(--navy);
    color: #fff;
  }

  .hero-inner {
    max-width: 780px;
    margin-inline: auto;
    text-align: center;
  }

  .hero-inner h1 {
    overflow-wrap: break-word;
  }

  .sub {
    max-width: 36em;
    margin: 22px auto 0;
    color: var(--dim);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }

  .hero-rating {
    margin-top: 36px;
  }

  .probleem {
    padding: 96px 0;
    background: var(--sky);
    color: var(--ink);
  }

  .probleem-lede {
    max-width: 52ch;
    margin-top: 16px;
    margin-bottom: 56px;
    color: var(--ink);
    opacity: 0.7;
  }

  .probleem-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    list-style: none;
  }

  .probleem-grid--4 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .probleem-grid li {
    min-width: 0;
    padding-top: 24px;
    border-top: 2px solid var(--line);
  }

  .probleem-grid li:first-child {
    border-top-color: var(--accent);
  }

  .probleem-grid .nr {
    color: var(--body);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
  }

  .probleem-grid h3 {
    margin: 10px 0 12px;
    color: var(--ink);
    font-size: 1.1rem;
    overflow-wrap: break-word;
  }

  .probleem-grid p {
    max-width: 34ch;
    color: var(--ink);
    opacity: 0.7;
    font-size: 0.95rem;
    line-height: 1.6;
    overflow-wrap: break-word;
  }

  .probleem-cta {
    margin-top: 48px;
  }

  .wanneer {
    padding: var(--section) 0;
    background: var(--sky);
    color: var(--ink);
  }

  .wanneer-inner {
    max-width: 62ch;
    margin-inline: 0;
  }

  .wanneer p {
    margin-top: 18px;
    color: var(--body);
    font-size: 1.05rem;
    line-height: 1.65;
    overflow-wrap: break-word;
  }

  .extra {
    padding: 90px 24px;
    background: var(--paper);
    color: var(--ink);
  }

  .extra-inner {
    max-width: var(--max);
    margin-inline: auto;
  }

  .extra p {
    max-width: 68ch;
    margin-top: 18px;
    color: var(--body);
    font-size: 1.02rem;
    line-height: 1.65;
    text-align: left;
    overflow-wrap: break-word;
  }

  .waas-uitleg {
    padding: var(--section) 24px;
    background: var(--deep);
    color: #fff;
  }

  .waas-uitleg-inner {
    max-width: var(--max);
    margin-inline: auto;
  }

  .waas-uitleg-label {
    display: inline-flex;
    margin: 0 0 24px;
    padding: 5px 12px;
    border: 1px solid var(--deep-line);
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .waas-uitleg-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 48px 72px;
    align-items: start;
  }

  .waas-uitleg h2 {
    max-width: 10em;
    color: #fff;
  }

  .waas-uitleg-copy {
    padding: 32px 36px;
    border: 1px solid var(--deep-line);
    border-radius: 20px;
    background: var(--deep-card);
  }

  .waas-uitleg-copy > p:first-child {
    max-width: none;
    margin-top: 0;
    color: #b6c8d2;
    font-size: 1rem;
    line-height: 1.7;
  }

  .waas-uitleg-kern {
    max-width: none;
    margin-top: 28px;
    padding: 20px 0 0 22px;
    border-top: 1px solid var(--deep-line);
    border-left: 3px solid var(--lime);
    color: #fff;
    font-size: 1.08rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .waas-uitleg-kern span {
    display: block;
    margin-bottom: 5px;
    color: var(--lime);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .overnemen {
    padding: 96px 24px;
    background: #fff;
    color: var(--ink);
  }

  .overnemen-inner {
    max-width: var(--max);
    margin-inline: auto;
  }

  .overnemen-lede {
    max-width: 56ch;
    margin-top: 16px;
    margin-bottom: 40px;
    color: var(--ink);
    opacity: 0.7;
  }

  .overnemen-lijst {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 48px;
    list-style: none;
  }

  .overnemen-lijst li {
    position: relative;
    min-width: 0;
    padding-left: 26px;
    margin-bottom: 14px;
    color: var(--ink);
    opacity: 0.85;
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1.5;
    overflow-wrap: break-word;
  }

  .overnemen-lijst li::before {
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 600;
    content: "✓";
  }

  .aanpak {
    padding: calc(var(--section) + 40px) 0 var(--section);
    background: #fff;
    color: var(--ink);
  }

  .proces-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px 28px;
    margin-top: 40px;
    list-style: none;
  }

  .proces-grid li {
    min-width: 0;
    padding-top: 20px;
    border-top: 2px solid var(--line);
  }

  .proces-grid li:first-child {
    border-top-color: var(--accent);
  }

  .nr {
    display: block;
    font-weight: 500;
  }

  .proces-grid .nr {
    color: var(--body);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }

  .proces-grid h3 {
    margin-top: 14px;
    color: var(--ink);
  }

  .proces-grid p {
    margin-top: 10px;
    color: var(--ink);
    opacity: 0.7;
    line-height: 1.55;
  }

  .faq {
    padding: var(--section) 0;
    background: var(--navy);
    color: #fff;
  }

  .faq .badge {
    display: inline-flex;
    margin-bottom: 16px;
    padding: 5px 12px;
    border: 1px solid var(--navy-line);
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px 48px;
    align-items: end;
    margin-bottom: 48px;
  }

  .faq-aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .faq-lede {
    color: #b6c8d2;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .close {
    padding: var(--section) 0;
    background: var(--deep);
    color: #fff;
    text-align: center;
  }

  .close-inner {
    max-width: 640px;
  }

  .close .btn {
    margin-top: 28px;
  }

  .related {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 28px;
    margin-top: 36px;
  }

  .related a {
    max-width: 100%;
    color: var(--lime);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    overflow-wrap: break-word;
  }

  .related a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 899px) {
    .probleem {
      padding: 70px 0;
    }

    .probleem-grid,
    .probleem-grid--4 {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 939px) {
    .hero {
      padding: 64px 0 48px;
    }

    .split {
      grid-template-columns: 1fr;
    }

    .proces-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .waas-uitleg-grid {
      grid-template-columns: 1fr;
    }

    .waas-uitleg h2 {
      max-width: 14em;
    }
  }

  @media (max-width: 699px) {
    .proces-grid {
      grid-template-columns: 1fr;
    }

    .overnemen-lijst {
      grid-template-columns: 1fr;
    }

    .waas-uitleg {
      padding-inline: 24px;
    }

    .waas-uitleg-copy {
      padding: 26px 24px;
    }
  }
</style>
