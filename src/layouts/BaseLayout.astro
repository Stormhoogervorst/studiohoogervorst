---
import "../styles/tokens.css";
import CookieBanner from "../components/CookieBanner.astro";
import SEO from "../components/SEO.astro";
import TabTitleSwitcher from "../components/TabTitleSwitcher.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;

const site = Astro.site ?? new URL("https://neqst.nl");

const org = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Neqst",
  url: site.origin,
  description: "Websites op abonnementsbasis, gebouwd om gevonden te worden.",
  email: "storm@neqst.nl",
  telephone: "+31685680998",
  areaServed: "NL",
  // LinkedIn, Google Business Profile en KvK-vermelding — belangrijkste entiteitssignaal.
  sameAs: ["https://www.linkedin.com/company/stormsites"],
};
---

<!doctype html>
<html lang="nl-NL">
  <head>
    <script is:inline>
      (function () {
        var MEASUREMENT_ID = "G-GBP06Z8PJY";
        var STORAGE_KEY = "neqst-cookie-consent";

        window.dataLayer = window.dataLayer || [];
        function gtag() {
          window.dataLayer.push(arguments);
        }
        window.gtag = gtag;

        function readChoice() {
          try {
            return localStorage.getItem(STORAGE_KEY);
          } catch (error) {
            return null;
          }
        }

        function writeChoice(value) {
          try {
            localStorage.setItem(STORAGE_KEY, value);
          } catch (error) {
            /* privémodus of geblokkeerde opslag */
          }
        }

        function loadAnalytics() {
          if (window.__neqstGaLoaded) return;
          window.__neqstGaLoaded = true;

          var script = document.createElement("script");
          script.async = true;
          script.src = "https://www.googletagmanager.com/gtag/js?id=" + MEASUREMENT_ID;
          script.onload = function () {
            gtag("js", new Date());
            gtag("config", MEASUREMENT_ID);
          };
          document.head.appendChild(script);
        }

        function clearAnalyticsCookies() {
          var cookies = document.cookie.split(";");
          for (var i = 0; i < cookies.length; i++) {
            var name = cookies[i].split("=")[0].trim();
            if (name !== "_ga" && name.indexOf("_ga_") !== 0 && name !== "_gid" && name !== "_gat") {
              continue;
            }
            document.cookie = name + "=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/";
            document.cookie =
              name + "=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/; domain=" + location.hostname;
          }
        }

        window.neqstConsent = {
          get: readChoice,
          accept: function () {
            writeChoice("accepted");
            loadAnalytics();
            document.dispatchEvent(new CustomEvent("neqst-consent", { detail: "accepted" }));
          },
          reject: function () {
            writeChoice("rejected");
            clearAnalyticsCookies();
            document.dispatchEvent(new CustomEvent("neqst-consent", { detail: "rejected" }));
          },
          open: function () {
            document.dispatchEvent(new CustomEvent("neqst-consent-open"));
          },
        };

        if (readChoice() === "accepted") {
          loadAnalytics();
        }

        document.addEventListener("click", function (event) {
          var target = event.target;
          if (!(target instanceof Element)) return;
          if (!target.closest("[data-cookie-settings]")) return;
          event.preventDefault();
          window.neqstConsent.open();
        });
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png?v=2" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png?v=2" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#082a3c" />
    <link
      rel="preload"
      href="/fonts/geist-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <SEO title={title} description={description} image={image} noindex={noindex} />
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
  </head>
  <body>
    <slot />
    <CookieBanner />
    <TabTitleSwitcher />
  </body>
</html>
