---
import "../styles/tokens.css";
import SEO from "../components/SEO.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;

const org = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Storm",
  url: "https://studiohoogervorst.nl",
  description: "Websites op abonnementsbasis, gebouwd om gevonden te worden.",
  email: "hoogervorstworks@gmail.com",
  telephone: "+31685680998",
  areaServed: "NL",
  // LinkedIn, Google Business Profile en KvK-vermelding — belangrijkste entiteitssignaal.
  sameAs: ["https://www.linkedin.com/company/stormsites"],
};
---

<!doctype html>
<html lang="nl-NL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png?v=2" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png?v=2" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#082a3c" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&display=swap"
      />
    </noscript>
    <SEO title={title} description={description} image={image} noindex={noindex} />
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
  </head>
  <body>
    <slot />
  </body>
</html>
