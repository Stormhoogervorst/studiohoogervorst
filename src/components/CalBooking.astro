---
const brandColor = "#082a3c";
const namespace = "30min";
const calLink = "storm-hoogervorst-neqst/30min";
---

<div class="cal-wrap">
  <div class="cal-slot" id="my-cal-inline-30min" data-cal-namespace={namespace}></div>
</div>

<script is:inline define:vars={{ brandColor, namespace, calLink }}>
  (function () {
    var slot = document.getElementById("my-cal-inline-30min");
    if (!slot) return;

    (function (C, A, L) {
      var p = function (a, ar) {
        a.q.push(ar);
      };
      var d = C.document;
      C.Cal =
        C.Cal ||
        function () {
          var cal = C.Cal;
          var ar = arguments;
          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            var script = d.createElement("script");
            script.src = A;
            script.async = true;
            d.head.appendChild(script);
            cal.loaded = true;
          }
          if (ar[0] === L) {
            var api = function () {
              p(api, arguments);
            };
            var ns = ar[1];
            api.q = api.q || [];
            if (typeof ns === "string") {
              cal.ns[ns] = cal.ns[ns] || api;
              p(cal.ns[ns], ar);
              p(cal, ["initNamespace", ns]);
            } else p(cal, ar);
            return;
          }
          p(cal, ar);
        };
    })(window, "https://app.cal.com/embed/embed.js", "init");

    Cal("init", namespace, { origin: "https://app.cal.com" });

    Cal.ns[namespace]("inline", {
      elementOrSelector: slot,
      calLink: calLink,
      config: {
        layout: "month_view",
        useSlotsViewOnSmallScreen: "true",
      },
    });

    Cal.ns[namespace]("ui", {
      theme: "light",
      hideEventTypeDetails: false,
      layout: "month_view",
      styles: { branding: { brandColor: brandColor } },
    });

    var tracked = false;
    function trackBooking() {
      if (tracked) return;
      tracked = true;
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: "cal_booking" });
      if (typeof window.gtag === "function") {
        window.gtag("event", "cal_booking");
      }
    }

    Cal.ns[namespace]("on", {
      action: "bookingSuccessful",
      callback: trackBooking,
    });
    Cal.ns[namespace]("on", {
      action: "bookingSuccessfulV2",
      callback: trackBooking,
    });
  })();
</script>

<style>
  .cal-wrap {
    width: 100%;
    min-height: 700px;
    background: #fff;
    border-radius: 12px;
  }

  .cal-slot {
    width: 100%;
    height: 100%;
    min-height: 700px;
  }

  .cal-slot :global(> div) {
    width: 100%;
    height: 100%;
    min-height: 700px;
    overflow: visible !important;
  }

  @media (max-width: 639px) {
    .cal-wrap,
    .cal-slot,
    .cal-slot :global(> div) {
      min-height: 600px;
    }
  }
</style>
