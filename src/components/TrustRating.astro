---
interface Props {
  align?: "center" | "start";
  tint?: "navy" | "licht";
}

const { align = "center", tint = "navy" } = Astro.props;
---

<div class:list={["trust", `trust--${align}`, `trust--${tint}`]}>
  <span class="stars" aria-hidden="true">
    {
      Array.from({ length: 5 }).map(() => (
        <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor">
          <path d="M10 1.6l2.35 4.76 5.25.76-3.8 3.7.9 5.24L10 13.58l-4.7 2.48.9-5.24-3.8-3.7 5.25-.76L10 1.6z" />
        </svg>
      ))
    }
  </span>
  <span class="divider" aria-hidden="true"></span>
  <span class="label">Gemiddeld beoordeeld met een 4,8</span>
</div>

<style>
  .trust {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 14px;
    color: var(--dim);
    font-size: 0.875rem;
  }

  .trust--center {
    justify-content: center;
  }

  .trust--start {
    justify-content: flex-start;
  }

  .stars {
    display: flex;
    flex-shrink: 0;
    gap: 3px;
    color: #fff;
  }

  .trust--licht .stars {
    color: var(--navy);
  }

  .stars svg {
    display: block;
    width: 14px;
    height: 14px;
    max-width: none;
    flex-shrink: 0;
  }

  .divider {
    flex-shrink: 0;
    width: 1px;
    height: 14px;
    background: rgba(255, 255, 255, 0.35);
  }

  .trust--licht .divider {
    background: var(--line);
  }

  .label {
    min-width: 0;
  }
</style>
