---
interface Rij {
  wat: string;
  zij: string;
  wij: string;
}

interface Props {
  kop?: string;
  rijen?: Rij[];
}

const defaultRijen: Rij[] = [
  { wat: "Investering vooraf", zij: "€3.000 tot €8.000", wij: "€395 setup" },
  {
    wat: "Maandelijkse kosten",
    zij: "Onderhoud op factuurbasis",
    wij: "€120, alles inbegrepen",
  },
  { wat: "Doorlooptijd", zij: "6 tot 12 weken", wij: "2 tot 3 weken" },
  {
    wat: "Vindbaarheid",
    zij: "Meestal een aparte offerte",
    wij: "Standaard in de bouw",
  },
  {
    wat: "Wijzigingen",
    zij: "Per uur gefactureerd",
    wij: "30 minuten per maand inbegrepen",
  },
  { wat: "Hosting en onderhoud", zij: "Apart contract", wij: "Inbegrepen" },
  {
    wat: "Offertetraject",
    zij: "Meerdere gesprekken",
    wij: "Prijzen staan gewoon op de site",
  },
];

const { kop = "Een lokaal bureau", rijen = defaultRijen } = Astro.props;
---

<section class="vergelijking">
  <div class="wrap">
    <p class="badge">Vergelijking</p>
    <h2>{kop} versus Storm Sites.</h2>
    <table>
      <thead>
        <tr>
          <th scope="col">Wat</th>
          <th scope="col">{kop}</th>
          <th scope="col" class="wij">Storm Sites</th>
        </tr>
      </thead>
      <tbody>
        {
          rijen.map((rij) => (
            <tr>
              <th scope="row" data-label="Wat">
                {rij.wat}
              </th>
              <td data-label={kop}>{rij.zij}</td>
              <td class="wij" data-label="Storm Sites">
                {rij.wij}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<style>
  .vergelijking {
    padding: var(--section) 0;
    background: var(--deep);
    color: #fff;
  }

  .badge {
    display: inline-flex;
    margin-bottom: 16px;
    padding: 5px 12px;
    border: 1px solid var(--deep-line);
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .vergelijking h2 {
    margin-bottom: 44px;
  }

  table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
  }

  th,
  td {
    padding: 18px 24px;
    text-align: left;
    vertical-align: top;
    font-weight: 400;
    line-height: 1.5;
  }

  thead th {
    padding-bottom: 14px;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  thead th.wij {
    padding-top: 18px;
    border-radius: 20px 20px 0 0;
    color: var(--lime);
  }

  tbody th,
  tbody td {
    border-top: 1px solid var(--deep-line);
  }

  tbody th {
    font-weight: 600;
  }

  tbody td {
    color: rgba(255, 255, 255, 0.68);
  }

  th:first-child,
  td:first-child {
    padding-left: 0;
  }

  .wij {
    background: var(--deep-card);
  }

  tbody td.wij {
    position: relative;
    padding-left: 50px;
    border-top-color: rgba(255, 255, 255, 0.07);
    color: #fff;
    font-weight: 500;
  }

  tbody td.wij::before {
    position: absolute;
    left: 24px;
    color: var(--lime);
    font-weight: 600;
    content: "✓";
  }

  tbody tr:last-child td.wij {
    border-radius: 0 0 20px 20px;
  }

  @media (max-width: 699px) {
    table,
    thead,
    tbody,
    tr,
    th,
    td {
      display: block;
      width: 100%;
    }

    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    tbody tr {
      margin-bottom: 14px;
      padding: 22px;
      border-radius: 16px;
      background: var(--deep-card);
    }

    tbody th,
    tbody td {
      padding: 0;
      border: 0;
    }

    tbody th {
      margin-bottom: 14px;
      font-size: 1.05rem;
    }

    tbody td,
    tbody td.wij {
      padding-top: 12px;
      margin-top: 12px;
      border-top: 1px solid var(--deep-line);
      background: none;
    }

    tbody td.wij {
      padding-left: 0;
      border-radius: 0;
    }

    tbody td::before,
    tbody td.wij::before {
      position: static;
      display: block;
      margin-bottom: 4px;
      color: rgba(255, 255, 255, 0.5);
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      content: attr(data-label);
    }

    tbody td.wij::before {
      color: var(--lime);
    }
  }
</style>
