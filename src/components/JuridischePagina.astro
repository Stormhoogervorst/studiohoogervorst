---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";

interface Props {
  entry: CollectionEntry<"juridisch">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);

const { titel, beschrijving, bijgewerkt } = entry.data;
const title = `${titel} | Storm Sites`;
const site = Astro.site ?? new URL("https://studiohoogervorst.nl");
const pageUrl = new URL(Astro.url.pathname, site).href;

const bijgewerktLabel = bijgewerkt.toLocaleDateString("nl-NL", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: titel,
  description: beschrijving,
  url: pageUrl,
  dateModified: bijgewerkt.toISOString().slice(0, 10),
  inLanguage: "nl-NL",
  isPartOf: {
    "@type": "WebSite",
    name: "Storm Sites",
    url: site.href,
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: new URL("/", site).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: titel,
      item: pageUrl,
    },
  ],
};
---

<BaseLayout title={title} description={beschrijving}>
  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <SiteHeader />

  <main id="inhoud">
    <section class="hero">
      <div class="wrap hero-inner">
        <h1>{titel}</h1>
        <p class="lede">{beschrijving}</p>
        <p class="meta">Laatst bijgewerkt op {bijgewerktLabel}</p>
      </div>
    </section>

    <section class="body">
      <div class="wrap layout">
        <nav class="toc" aria-label="Inhoudsopgave">
          <p class="toc-label">Inhoud</p>
          <ol>
            {toc.map((item) => (
              <li>
                <a href={`#${item.slug}`}>{item.text}</a>
              </li>
            ))}
          </ol>
        </nav>

        <article class="card prose">
          <Content />
        </article>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .hero {
    padding: 72px 0 64px;
    background: var(--deep);
    color: #fff;
  }

  .hero-inner {
    max-width: 760px;
  }

  .lede,
  .meta {
    margin-top: 18px;
    color: #fff;
    opacity: 0.7;
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .meta {
    margin-top: 12px;
    font-size: 0.9375rem;
  }

  .body {
    padding: 48px 0 var(--section);
    background: var(--deep);
    color: #fff;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(180px, 220px) minmax(0, 760px);
    gap: 40px;
    justify-content: center;
    align-items: start;
  }

  .toc {
    position: sticky;
    top: 32px;
  }

  .toc-label {
    margin-bottom: 14px;
    color: #fff;
    opacity: 0.7;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .toc ol {
    display: grid;
    gap: 10px;
    list-style: none;
  }

  .toc a {
    color: #fff;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.35;
    text-decoration: none;
  }

  .toc a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .card {
    max-width: 760px;
    padding: 48px;
    border-radius: 20px;
    background: #fff;
  }

  .prose :global(h2) {
    margin-top: 48px;
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(h3) {
    margin-top: 28px;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.25;
  }

  .prose :global(p),
  .prose :global(li) {
    max-width: 68ch;
    color: var(--body);
    font-size: 1rem;
    line-height: 1.65;
  }

  .prose :global(p + p),
  .prose :global(ul + p),
  .prose :global(ol + p),
  .prose :global(table + p),
  .prose :global(p + ul),
  .prose :global(p + ol),
  .prose :global(p + table) {
    margin-top: 1em;
  }

  .prose :global(h2 + p),
  .prose :global(h3 + p),
  .prose :global(h2 + ul),
  .prose :global(h3 + ul),
  .prose :global(h2 + ol),
  .prose :global(h3 + ol),
  .prose :global(h2 + table),
  .prose :global(h3 + table) {
    margin-top: 14px;
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .prose :global(a) {
    color: var(--ink);
    font-weight: 500;
    text-underline-offset: 3px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    display: grid;
    gap: 0.55em;
    margin-top: 1em;
    padding-left: 1.25em;
    list-style: revert;
  }

  .prose :global(ul) {
    list-style-type: disc;
  }

  .prose :global(ol) {
    list-style-type: decimal;
  }

  .prose :global(hr) {
    margin: 36px 0;
    border: 0;
    border-top: 1px solid var(--line);
  }

  .prose :global(table) {
    width: 100%;
    margin-top: 1em;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 12px 14px;
    border: 1px solid var(--line);
    color: var(--body);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    color: var(--ink);
    font-weight: 600;
  }

  @media (max-width: 939px) {
    .layout {
      grid-template-columns: minmax(0, 760px);
    }

    .toc {
      display: none;
    }

    .card {
      padding: 32px 24px;
    }

    .hero {
      padding: 56px 0 48px;
    }
  }
</style>
